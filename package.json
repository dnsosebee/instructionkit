{
  "name": "replicache-todo",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write './**/*.{js,jsx,json,ts,tsx,html,css,md}'",
    "lint": "eslint src/**/*.{ts,tsx}; npx stylelint '**/*.css'",
    "inconsistencies": "npx eslint-config-prettier pages/index.tsx",
    "pre-commit": "lint-staged --verbose",
    "prepare": "husky install"
  },
  "engines": {
    "//": "replicache-nextjs requires npm >= 7. This was released in Node 15, but 16 is current stable so we choose that. Render looks at package.json to determine which Node to use: https://render.com/docs/node-version.",
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.3",
    "@heroicons/react": "^2.0.12",
    "@tiptap/extension-document": "^2.0.0-beta.196",
    "@tiptap/extension-paragraph": "^2.0.0-beta.196",
    "@tiptap/extension-placeholder": "^2.0.0-beta.199",
    "@tiptap/extension-text": "^2.0.0-beta.196",
    "@tiptap/react": "^2.0.0-beta.195",
    "@tiptap/starter-kit": "^2.0.0-beta.195",
    "classnames": "^2.3.1",
    "immutable": "^4.1.0",
    "lodash": "^4.17.21",
    "next": "^12.1.6",
    "node-html-parser": "^6.1.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "reactflow": "^11.0.0",
    "replicache": "^11.0.0",
    "replicache-nextjs": "^0.4.0",
    "replicache-react": "^2.9.0",
    "valtio": "^1.7.0"
  },
  "devDependencies": {
    "dotenv": "^16.0.2",
    "@tailwindcss/typography": "^0.5.7",
    "@types/lodash": "^4.14.186",
    "@types/node": "^14.14.37",
    "@types/react": "^17.0.11",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "autoprefixer": "^10.4.11",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-valtio": "^0.6.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.16",
    "prettier": "^2.2.1",
    "stylelint": "^14.13.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^28.0.0",
    "tailwindcss": "^3.1.8",
    "ts-node": "^10.7.0",
    "typescript": "^4.7.4"
  },
  "eslintConfig": {
    "ecmaFeatures": {
      "jsx": true,
      "modules": true
    },
    "env": {
      "browser": true,
      "node": true
    },
    "parser": "babel-eslint",
    "rules": {
      "quotes": [
        2,
        "single"
      ],
      "strict": [
        2,
        "never"
      ],
      "react/jsx-uses-react": 2,
      "react/jsx-uses-vars": 2,
      "react/react-in-jsx-scope": 2
    },
    "plugins": [
      "react"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --allow-empty-input"
    ]
  }
}
