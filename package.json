{
  "name": "instruction-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write './**/*.{js,jsx,json,ts,tsx,html,css,md}'",
    "lint": "eslint src/**/*.{ts,tsx}; npx stylelint '**/*.css'",
    "inconsistencies": "npx eslint-config-prettier pages/index.tsx",
    "pre-commit": "lint-staged --verbose",
    "prepare": "husky install"
  },
  "engines": {
    "//": "replicache-nextjs requires npm >= 7. Node 24 is the current LTS version. Render looks at package.json to determine which Node to use: https://render.com/docs/node-version.",
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.3",
    "@heroicons/react": "^2.0.12",
    "@rocicorp/undo": "^0.2.0",
    "@supabase/auth-helpers-nextjs": "^0.5.2",
    "@supabase/auth-helpers-react": "^0.3.1",
    "@supabase/auth-ui-react": "^0.2.6",
    "@supabase/supabase-js": "^2.2.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tiptap-pro/extension-unique-id": "^2.0.0-beta.14",
    "@tiptap/extension-code-block-lowlight": "^2.0.0-beta.199",
    "@tiptap/extension-document": "^2.0.0-beta.196",
    "@tiptap/extension-link": "^2.0.0-beta.204",
    "@tiptap/extension-paragraph": "^2.0.0-beta.196",
    "@tiptap/extension-placeholder": "^2.0.0-beta.199",
    "@tiptap/extension-task-item": "^2.0.0-beta.209",
    "@tiptap/extension-task-list": "^2.0.0-beta.209",
    "@tiptap/extension-text": "^2.0.0-beta.196",
    "@tiptap/react": "^2.0.0-beta.195",
    "@tiptap/starter-kit": "^2.0.0-beta.195",
    "@xstate/react": "^3.0.1",
    "airtable": "^0.11.5",
    "classnames": "^2.3.1",
    "eslint-config-next": "^13.0.4",
    "esprima": "^4.0.1",
    "framer-motion": "^7.6.2",
    "immutable": "^4.1.0",
    "lodash": "^4.17.21",
    "lowlight": "^2.7.0",
    "next": "^13.0.4",
    "node-html-parser": "^6.1.1",
    "pino": "^8.7.0",
    "prosemirror-dev-toolkit": "^1.0.5",
    "prosemirror-utils": "^0.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "reactflow": "^11.0.0",
    "replicache": "^12.0.0",
    "replicache-nextjs": "^0.5.1",
    "replicache-react": "^2.9.0",
    "valtio": "^1.7.0",
    "xstate": "^4.35.0",
    "zod": "^3.19.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.7",
    "@types/airtable": "^0.10.1",
    "@types/esprima": "^4.0.3",
    "@types/lodash": "^4.14.186",
    "@types/node": "^14.14.37",
    "@types/react": "^17.0.11",
    "@types/wicg-file-system-access": "^2020.9.5",
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "autoprefixer": "^10.4.11",
    "dotenv": "^16.0.2",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-valtio": "^0.6.1",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "pg-mem": "^2.6.4",
    "postcss": "^8.4.16",
    "prettier": "^2.2.1",
    "stylelint": "^14.13.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^28.0.0",
    "supabase": "^1.14.3",
    "tailwindcss": "^3.1.8",
    "ts-node": "^10.7.0",
    "typescript": "^4.7.4",
    "worker-loader": "^3.0.8"
  },
  "eslintConfig": {
    "ecmaFeatures": {
      "jsx": true,
      "modules": true
    },
    "env": {
      "browser": true,
      "node": true
    },
    "parser": "babel-eslint",
    "rules": {
      "quotes": [
        2,
        "single"
      ],
      "strict": [
        2,
        "never"
      ],
      "react/jsx-uses-react": 2,
      "react/jsx-uses-vars": 2,
      "react/react-in-jsx-scope": 2
    },
    "plugins": [
      "react"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --allow-empty-input"
    ]
  }
}
